# OpenAI reads the still (gpt-4.1). Anthropic is the fallback. Mini prices the named model.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_PRICE_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
# 0 keeps SerpAPI off by default (falls back to model resale price). Set 1 to enable.
SERPAPI_ENABLED=0

# 1 forces zero-internet offline fallback with realistic catalog items.
# The fallback picks its canned exhibit from a hash of the frame, so the
# same view always returns the same item.
RIG_OFFLINE=0

# Case ledger is mirrored to this JSON file on every change, so a crash or
# restart reopens the same case. Empty uses rig/state/case.json.
RIG_STATE_FILE=

# Consecutive changed samples required before a look. 1 is the old
# single-sample gate; 2 ignores one-frame flicker (lights, sensor noise).
SCENE_CONFIRM=2

# Mean pixel diff (0-255) that counts as a new scene. Raise it if a dark room
# keeps the gate open; lower it if subtle swaps get missed.
SCENE_THRESH=8.0

# Minimum seconds between model calls. Raise it if the API bill climbs.
LOOK_EVERY=2.5

# Seconds a new find keeps its box on the live picture. It stays in the tally,
# the case file and the Tiger ledger after that. 0 = boxes never clear.
MARKER_SECONDS=3

# Exhibit still quality, 30-100.
JPEG_QUALITY=85

# 1 sends every frame to the model. Leave unset to skip static shots.
SCAN_ALWAYS=

# 1 plays a scripted walk with no camera and no keys.
RIG_SCRIPT=

# Webcam index. 0 is the first camera.
CAM_INDEX=0

# Hub only: where the picture comes from. Empty = the hub's own camera.
# rover = show and scan the rover's camera (the hub pulls <rover>:5001/frame.jpg
# once the rover has pinged); pair it with ROVER_VISION=0 on the rover.
# An http(s) URL = a camera another program already serves. A video stream
# (SunFounder vilib: http://<pi>:9000/mjpg) is relayed to the consoles at the
# camera's own frame rate; a URL ending .jpg is polled one still at a time.
CAM_SOURCE=

# Windows: dshow, msmf, or any. Pi: v4l2 or any; picamera for a ribbon-cable
# Pi Camera Module (libcamera). Empty picks a sensible default.
CAM_BACKEND=

# 0.0.0.0 serves the room; 127.0.0.1 keeps the dashboard on this machine.
# RIG_BIND overrides HOST if set.
HOST=0.0.0.0
RIG_BIND=
PORT=5000

# The narrator (rig/voice/lines.json): 0 keeps it silent but still writes
# every line to the desk's transcript. 1 plays the bundled clips on the hub's
# speaker, and speaks item names/prices and radio answers with TTS.
RIG_VOICE=0
# Narrator volume, 0-100 (0 = mute, transcript only).
NARRATOR_VOLUME=100
# Running-take thresholds that get a "that's real money now" line.
NARRATOR_MILESTONES=1000,5000,10000,25000
# Seconds the camera must stay down before the narrator says so (no flapping).
NARRATOR_CAMERA_DEBOUNCE=2
# Local voice for dynamic speech on a Mac with no OpenAI key (macOS `say`).
NARRATOR_LOCAL_VOICE=Daniel
# OpenAI TTS cache for repeated dynamic lines. Empty = rig/state/tts-cache.
NARRATOR_CACHE=

# --- Multi-device (hub = the hat's Pi; wrist + rover talk to it) ---

# Shared secret for the rover's POSTs. Empty = open LAN demo; set it when
# the rover joins the hotspot. 'auto' mints a per-boot secret and logs it
# once — secure by default with nothing to configure. When set, reads lock
# too: /state.json, /frame.jpg, /crop/*, /wrist.json all need the token
# (dashboard/desk prompt for it once; ESP32: fill RIG_TOKEN in wrist.ino).
# Pages, /manifest, and /health stay open — kiosk curl and the QR board
# can't send headers, and neither carries a secret.
RIG_TOKEN=

# Rover only: where the hub lives.
HUB_URL=http://raspberrypi.local:5000

# Rover only: 0 = camera feed and wheels only, the hub does the looking
# (CAM_SOURCE=rover on the hub). The rover then needs no model keys.
ROVER_VISION=1

# Hub only: mic button pin for a radio call (records LISTEN_SECS, Whisper
# turns it into text, dispatch answers from the live plan; no model invents it).
LISTEN_PIN=27
LISTEN_SECS=4
WHISPER_MODEL=whisper-1

# Rover only: marks this box so `python -m rig.diag` runs the motor probe.
RIG_ROLE=

# Ledger cap — each exhibit holds its JPEG still in memory, so this bounds
# RAM on the Pi even under LAN spam. New exhibits are refused past it.
MAX_EXHIBITS=500

# Rover only: motor GPIOs "left-fwd,left-back,right-fwd,right-back" for a
# TB6612/L298N pair. Teleop: POST /api/drive on the hub, or WASD on the
# dashboard. With no GPIO (laptop/test) the console driver logs moves.
DRIVE_PINS=22,23,24,25
# Which wheels: picarx = SunFounder PiCar-X (Robot HAT, steers like a car;
# PICARX_SPEED 10-100), gpio = the DRIVE_PINS pair. Empty tries PiCar-X first.
DRIVE_KIT=
PICARX_SPEED=40
# Idle teleop for this many seconds and the rover replays its breadcrumb
# trail home (dead-reckoning — drifts on wheel slip). 0 disables.
DRIVE_RETURN_AFTER=60
# POST /drive {"dir":"return"} forces it now. Beacon correction: print
# home-marker.png (python -m rig.marker) and tape it at the drop point —
# during return, the camera sights it and steers in instead of guessing.
HOME_MARKER_ID=0

# Dynamic speech ladder: cached TTS -> OpenAI TTS -> macOS say / pyttsx3 ->
# transcript only. Also the voice `python -m rig.narration build` uses.
TTS_MODEL=tts-1
TTS_VOICE=onyx

# --- Tiger Cloud (TimescaleDB): the cloud event ledger ---
# Every recognition is appended to a `detections` hypertable for fast analytics
# (take over time, lifetime leaderboards) and cross-device push. Empty = off:
# the JSON case file stays the only ledger and nothing is sent anywhere.
# Postgres connection string from the Tiger Cloud console, e.g.
#   postgres://tsdbadmin:<pw>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Bootstrap the schema once against a writable service:
#   python -m rig.timescale bootstrap
TIGER_DB_URL=

# --- Vultr Serverless Inference: the CV model + the analysis brain ---
# OpenAI-compatible; reuses the openai client against Vultr's base URL. Empty =
# off (OpenAI/Anthropic/offline unchanged). Set the key to add Vultr to the
# vision ladder; set VULTR_VISION_FIRST=1 to make it the primary CV engine.
VULTR_API_KEY=
VULTR_BASE_URL=https://api.vultrinference.com/v1
VULTR_VISION_FIRST=0
# Image-capable model that identifies items; text model that writes the debrief.
VULTR_VISION_MODEL=glm-5.3
VULTR_TEXT_MODEL=glm-5.3
# For models that reason before answering (e.g. glm-5.3): low|medium|high effort,
# a higher token cap for both calls (the thinking counts against it), and a
# longer per-call time limit in seconds. Empty keeps the built-in defaults.
VULTR_REASONING_EFFORT=medium
VULTR_MAX_TOKENS=200000
VULTR_TIMEOUT=90

# Every look identifies EVERY object in the frame (not just the clearest one) and
# streams them all to the Tiger ledger. This caps how many objects one look may
# file, so a busy shelf can't flood a single model reply.
VISION_MAX_OBJECTS=8

# exits = case-the-exits mode: the vision pass marks doors/windows instead
# of pricing loot. Leave empty for the appraisal job.
# In the appraisal job, a badge/keycard/school ID in frame files as a cloned
# credential: the model reads the printed name, ID number, school or issuer,
# role, card number, and issue/expiry dates (tuned for the UTD Comet Card;
# show front then back and they merge into one exhibit). Never real payment cards: a Visa/Mastercard/Amex/Discover
# number is masked to its last four before it is filed.
RIG_MODE=

# 1 = print a paper LOOT MANIFEST on reveal. Needs python-escpos + a USB
# 58mm POS printer. Anything missing logs and the reveal goes on paperless.
RIG_PRINTER=0
# Printer USB IDs from `lsusb` — most 58mm POS units are 0483:5740.
PRINTER_USB=0x0483:0x5740

# Optional prop triggers (both off unless pinned):
#   TRIPWIRE_PIN — LDR on a GPIO: laser beam break fires reveal/reset.
#   DIAL_PINS=a,b — KY-040 rotary; DIAL_TICKS detents "crack the vault".
TRIPWIRE_PIN=
DIAL_PINS=
DIAL_TICKS=8

# Optional recorded lines. Drop alert.wav and reveal.wav in rig/voice/.
# Anything missing is spoken instead.

# --- Defender Report (owner's view of a closed case: /report/<id>) ---
# 0 turns reports off. On, the reveal files one and a reset waits for it.
RIG_REPORTS=1
# Where finalized reports live. Empty = <state dir>/reports.
RIG_REPORTS_DIR=
# Retention: keep the newest N reports with evidence, and expire any older
# than D days (0 = no age limit). Expired reports keep a tombstone page.
RIG_REPORT_KEEP=20
RIG_REPORT_DAYS=7

# --- Bring-up journal ---
# Console + rotating file at rig/state/logs/rig.log (5MB x3). Hardware
# up/down transitions are logged under the 'rig.hw' logger — the journal
# reads as a bring-up checklist and a flap detector.
#   python -m rig.journal -f          tail it live
#   python -m rig.journal --hw        hardware events only
#   python -m rig.journal --errors    warnings and errors only
# RIG_LOG_LEVEL=DEBUG for full chatter; RIG_LOG_JSON=1 for JSON lines;
# RIG_LOG_DIR=/path to put the file elsewhere.
RIG_LOG_LEVEL=INFO
